{
  "manifest_version": 3,
  "name": "CRM - Não Lidas + Groq + Dados + Skale V16.23",
  "version": "4.6.5",
  "description": "V16.23: resumo da conversa inteira, nova tentativa automática na Groq e limpeza do cache antigo; mantém Groq, Skale, ViaCEP, não lidas e identidade fixa.",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://*.datacrazy.io/*",
    "https://crm.datacrazy.io/*",
    "https://messaging.g1.datacrazy.io/*",
    "https://viacep.com.br/*",
    "https://*.whatsapp.net/*",
    "https://*.whatsapp.com/*",
    "https://api.groq.com/*",
    "https://skaletracking.com.br/*",
    "https://*.skaletracking.com.br/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://crm.datacrazy.io/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://crm.datacrazy.io/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://crm.datacrazy.io/*"
      ],
      "js": [
        "audio-hook.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://crm.datacrazy.io/*"
      ],
      "js": [
        "audio-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://crm.datacrazy.io/*"
      ],
      "js": [
        "order-data-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://skaletracking.com.br/*",
        "https://*.skaletracking.com.br/*"
      ],
      "js": [
        "skale-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "key": ""
}
