{
  "manifest_version": 3,
  "name": "CRM - Não Lidas + Transcrição/OCR VPS + Dados + Five Delivery V16.16",
  "version": "4.4.0",
  "description": "V16.16: correções de estabilidade (timeouts, cache, paginação parcial, relógio do PC) mantendo todas as melhorias anteriores.",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://*.datacrazy.io/*",
    "https://crm.datacrazy.io/*",
    "https://messaging.g1.datacrazy.io/*",
    "https://viacep.com.br/*",
    "https://app.fivedelivery.com.br/*",
    "https://*.whatsapp.net/*",
    "https://*.whatsapp.com/*",
    "https://trascricao.masterautomacoes.com.br/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://crm.datacrazy.io/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://crm.datacrazy.io/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://crm.datacrazy.io/*"
      ],
      "js": [
        "audio-hook.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://crm.datacrazy.io/*"
      ],
      "js": [
        "audio-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://crm.datacrazy.io/*"
      ],
      "js": [
        "order-data-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://app.fivedelivery.com.br/*"
      ],
      "js": [
        "five-delivery-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "key": ""
}
