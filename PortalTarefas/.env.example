# ============================================================================
# Variáveis de configuração do Portal de Tarefas — SEM valores secretos.
# Copie para .env (ignorado pelo Git) para uso local com scripts/ e compose.yaml.
# Em produção, forneça os valores pelo secret store do provedor.
# ============================================================================

# --- Usadas pelo compose.yaml / scripts locais ---
MSSQL_SA_PASSWORD=          # senha do 'sa' do SQL Server local (somente desenvolvimento)
SEED_SENHA=                 # senha inicial dos usuários de teste (ana, bruno, carla, visitante)
APP_VERSION=                # versão gravada na imagem (ex.: 1.0.0+<sha>)
APP_COMMIT=                 # commit que gerou a imagem

# --- Lidas pela aplicação (formato variável de ambiente: seção__chave) ---
# ConnectionStrings__PortalTarefas      OBRIGATÓRIA. Conexão SQL Server. Dev: User Secrets.
# Dependencias__Calendario__Url         OBRIGATÓRIA. URL do serviço de calendário (validada no início).
# SeedUsuarios__SenhaInicial            Opcional. Sem ela, usuários de teste não são criados.
# Banco__AplicarMigrations              true/false. Aplica migrations + seed ao iniciar (dev/teste).
# DataProtection__Caminho               Pasta persistente das chaves que cifram o cookie de sessão.
# Cors__Origens__0                      Origem autorizada para CORS (dev: http://localhost:5173).
# RateLimit__Api__Limite / __JanelaSegundos, RateLimit__Publica__..., RateLimit__Login__Limite
# Seguranca__IntervaloValidacaoStamp    Intervalo de verificação do security stamp (padrão 00:00:00).
# OTEL_EXPORTER_OTLP_ENDPOINT           Coletor OTLP (ex.: http://localhost:4317). Vazio = sem exportação.
# Telemetria__Console                   true para exportar traces/métricas no console.
# APP_VERSION / APP_COMMIT              Gravadas na imagem; expostas em GET /api/versao.
# ASPNETCORE_ENVIRONMENT                Development | Staging | Production.
