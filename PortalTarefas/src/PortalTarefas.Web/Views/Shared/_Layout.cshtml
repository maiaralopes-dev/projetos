<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Portal de Tarefas</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topo">
        <a class="marca" asp-controller="Tarefas" asp-action="Index">Portal de Tarefas</a>
        <nav>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Tarefas" asp-action="Index">Lista</a>
                @if (User.IsInRole("Usuario") || User.IsInRole("Administrador"))
                {
                    <a asp-controller="Tarefas" asp-action="Create">Nova tarefa</a>
                }
                <span class="usuario">@User.Identity.Name</span>
                <form asp-controller="Conta" asp-action="Logout" method="post" class="inline"><button type="submit" class="link">Sair</button></form>
            }
        </nav>
    </header>
    <div class="conteudo">
        <main>
            @if (TempData["Mensagem"] is string mensagem)
            {
                <div class="aviso" role="status">@mensagem</div>
            }
            <h1>@ViewData["Title"]</h1>
            @RenderBody()
        </main>
        <aside>
            @if (User.Identity?.IsAuthenticated == true)
            {
                @await Component.InvokeAsync("TarefasVencidas", new { maximo = 5 })
            }
        </aside>
    </div>
    <footer>Desenvolvimento Web com .NET · ASP.NET Core 10</footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
