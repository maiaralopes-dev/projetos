@model IReadOnlyList<TarefaResumoViewModel>
<section class="vencidas" aria-labelledby="titulo-vencidas">
    <h2 id="titulo-vencidas">Tarefas vencidas (@Model.Count)</h2>
    @if (Model.Count == 0)
    {
        <p>Nenhuma tarefa vencida.</p>
    }
    else
    {
        <ul>
            @foreach (var t in Model)
            {
                <li><a asp-controller="Tarefas" asp-action="Details" asp-route-id="@t.Id">@t.Titulo</a> · @t.Prazo?.ToString("dd/MM")</li>
            }
        </ul>
    }
</section>
