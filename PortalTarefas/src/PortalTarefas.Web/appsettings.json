{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "UseUtcTimestamp": true,
        "JsonWriterOptions": {
          "Indented": false
        }
      }
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origens": []
  },
  "Dependencias": {
    "Calendario": {
      "Url": "http://localhost:5099/"
    }
  },
  "RateLimit": {
    "Api": {
      "Limite": 100,
      "JanelaSegundos": 10
    },
    "Publica": {
      "Limite": 30,
      "JanelaSegundos": 10
    },
    "Login": {
      "Limite": 10
    }
  },
  "Telemetria": {
    "Console": false
  }
}