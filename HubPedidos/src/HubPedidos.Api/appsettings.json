{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Importacao": {
    "TamanhoBufferInicial": 16384,
    "TamanhoMaximoLinha": 65536,
