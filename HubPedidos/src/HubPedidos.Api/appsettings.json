{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Importacao": {
    "TamanhoBufferInicial": 16384,
    "TamanhoMaximoLinha": 65536,
    "LimiteBytes": 10485760,
    "LimparBuffer": false,
    "ItensPorFlush": 256
  },
  "ConnectionStrings": {
    "Hub": "Data Source=hubpedidos.db"
  },
  "Banco": {
    "AplicarMigrations": true,
    "SemearPedidos": 0,
    "MapeamentoMetadados": "Json"
  },
  "Fila": {
    "Capacidade": 500,
    "ModoCheio": "Wait",
    "TempoMaximoEsperaMs": 200,
    "Consumidores": 4,
    "LimiteBanco": 1,
    "Encerramento": "Drenar",
    "PrazoDrenagemSegundos": 20,
    "TamanhoLote": 32
  }
}